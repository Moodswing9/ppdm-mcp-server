# PowerProtect Data Manager
PPDM_HOST=your-ppdm-host.example.com
PPDM_USER=admin
PPDM_PASS=yourpassword
PPDM_PORT=8443
# TLS: certificates are always verified. For a self-signed appliance, trust its cert:
# PPDM_CA_FILE=/path/to/ppdm-ca.pem

# NetWorker (optional)
NW_HOST=your-nw-host.example.com
NW_USER=administrator
NW_PASS=yourpassword
NW_PORT=9090
# NW_CA_FILE=/path/to/networker-ca.pem

# Data Domain (optional)
DD_HOST=your-dd-host.example.com
DD_USER=sysadmin
DD_PASS=yourpassword
DD_PORT=3009
# DD_CA_FILE=/path/to/datadomain-ca.pem
